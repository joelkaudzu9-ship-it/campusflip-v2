{
  "name": "campusflip-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:smoke": "node tests/smoke.mjs",
    "build:mock": "VITE_SUPABASE_URL=https://mock.supabase.co VITE_SUPABASE_ANON_KEY=mock vite build --outDir .mockdist",
    "lint": "eslint . --max-warnings 0",
    "test:contrast": "CONTRAST_STRICT=1 node tests/contrast.mjs",
    "test:db": "bash supabase/tests/ci/run.sh",
    "test": "npm run lint && npm run build:mock && npm run test:smoke && npm run test:contrast"
  },
  "dependencies": {
    "@sentry/react": "^8.55.2",
    "@supabase/supabase-js": "^2.119.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "playwright": "^1.49.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
